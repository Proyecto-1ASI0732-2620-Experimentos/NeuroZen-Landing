---
import { Image } from "astro:assets";
import SocialNetworkLogo from "./components/SocialNetworkLogo.astro";
import NeuroZenLogo from "@/assets/images/Principales/Logo.png";
import NeuroZenLogoText from "@/assets/images/Principales/NeuroZen_Texto.png";
import { webAppLinks } from "@/consts/links";
import { socialLinks } from "@/consts/social";
import {
  getHomeAnchor,
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();

// Anclas absolutas a la home para que funcionen desde cualquier página.
const platform = [
  { name: "nav.benefits", href: getHomeAnchor(lang, "#beneficios") },
  { name: "nav.exercises", href: getHomeAnchor(lang, "#ejercicios") },
  { name: "nav.aboutus", href: getHomeAnchor(lang, "#nosotros") },
  { name: "nav.plans", href: getHomeAnchor(lang, "#planes") },
  { name: "nav.psychologists", href: getHomeAnchor(lang, "#psicologos") },
] as const;

const access = [
  { name: "nav.register", href: webAppLinks.register },
  { name: "nav.login", href: webAppLinks.login },
  { name: "nav.download", href: getLocalizedPath(lang, "descargar") },
] as const;

const linkClass =
  "inline-block py-1 text-green-100 hover:text-white underline-offset-4 hover:underline transition-colors duration-200";
---

<footer class="on-dark w-full bg-gradient-to-b from-[#0a5c20] to-[#033612] text-white">
  <div class="max-w-7xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12">
      <!-- Marca -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href={getLocalizedPath(lang)}
          class="inline-flex items-center gap-3 mb-4 rounded-lg"
          aria-label={t("nav.homeAria")}
        >
          <Image src={NeuroZenLogo} alt="" width={96} height={96} class="w-12 h-12" />
          <Image src={NeuroZenLogoText} alt="" width={320} class="w-40 h-auto" />
        </a>
        <p class="text-green-100 mb-6 leading-relaxed max-w-sm">
          {t("footer.slogan")}
        </p>
        {
          socialLinks.length > 0 && (
            <div class="flex gap-3">
              {socialLinks.map((s) => (
                <SocialNetworkLogo href={s.href} label={s.label} network={s.network} />
              ))}
            </div>
          )
        }
      </div>

      <!-- Plataforma -->
      <nav aria-labelledby="footer-platform">
        <h2 id="footer-platform" class="text-lg font-semibold mb-4 text-white">
          {t("footer.platform")}
        </h2>
        <ul class="space-y-2">
          {
            platform.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {t(item.name)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Accesos -->
      <nav aria-labelledby="footer-access">
        <h2 id="footer-access" class="text-lg font-semibold mb-4 text-white">
          {t("footer.access")}
        </h2>
        <p class="text-green-100 mb-3 text-sm">{t("footer.access.text")}</p>
        <ul class="space-y-2">
          {
            access.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {t(item.name)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-6">
      <p class="text-green-100 text-sm text-center md:text-left">
        © {currentYear}
        {t("footer.copyright")}
      </p>
    </div>
  </div>
</footer>
