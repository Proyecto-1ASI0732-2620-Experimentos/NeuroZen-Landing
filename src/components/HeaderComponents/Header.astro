---
import { Image } from "astro:assets";
import NeuroZenLogo from "@/assets/images/Principales/Logo.png";
import NeuroZenText from "@/assets/images/Principales/NeuroZen_Texto.png";
import LanguageSwitcher from "./components/LanguageSwitcher.astro";
import MobileMenu from "./components/MobileMenu.astro";
import menuItems from "@/consts/menu-item";
import { webAppLinks } from "@/consts/links";
import {
  getHomeAnchor,
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// En la home las anclas son locales; en otras páginas apuntan a la home.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/" || path === "/en";
const anchor = (hash: string) => (isHome ? hash : getHomeAnchor(lang, hash));
---

<header
  id="site-header"
  class="on-dark fixed top-0 left-0 right-0 z-50 flex w-full min-h-[72px] md:min-h-[80px] px-4 py-3 sm:px-5 items-center bg-[#033612]/95 backdrop-blur-md shadow-lg"
>
  <nav
    class="flex w-full items-center justify-between gap-3"
    aria-label={t("nav.main")}
  >
    <a
      href={getLocalizedPath(lang)}
      class="flex shrink-0 gap-2 sm:gap-3 items-center rounded-lg"
      aria-label={t("nav.homeAria")}
    >
      <Image
        class="w-10 h-10 sm:w-12 sm:h-12"
        src={NeuroZenLogo}
        alt=""
        width={96}
        height={96}
        loading="eager"
      />
      <Image
        class="hidden min-[400px]:block w-28 sm:w-30 h-auto"
        src={NeuroZenText}
        alt=""
        width={240}
        loading="eager"
      />
    </a>

    <div class="flex gap-2 lg:gap-3 items-center">
      <ul class="hidden xl:flex gap-1">
        {
          menuItems.map((item) => (
            <li>
              <a
                href={anchor(item.href)}
                class="menu-item block px-3 py-2.5 text-white text-base hover:bg-white/10 rounded-lg transition-colors duration-200"
              >
                {t(item.name as any)}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden sm:flex items-center gap-2">
        <a href={webAppLinks.login} class="btn btn-ghost-light px-4 py-2">
          {t("nav.login")}
        </a>
        <a href={webAppLinks.register} class="btn btn-light px-4 py-2">
          {t("nav.register")}
        </a>
      </div>

      <!-- En móviles: registro compacto visible (login en el menú y en el hero) -->
      <a
        href={webAppLinks.register}
        class="btn btn-light sm:hidden px-3 py-2 text-sm min-h-11"
      >
        {t("nav.register")}
      </a>

      <LanguageSwitcher />

      <button
        id="hamburger-btn"
        type="button"
        class="inline-flex items-center justify-center size-11 rounded-lg bg-white/10 border border-white/40 cursor-pointer hover:bg-white/20 transition-colors duration-200 xl:hidden"
        aria-label={t("nav.openMenu")}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-6 text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<MobileMenu isHome={isHome} />

<style>
  .menu-item {
    position: relative;
  }

  .menu-item::before {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background: #8ad0b3;
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .menu-item:hover::before {
    transform: scaleX(1);
  }
</style>

<script>
  const header = document.getElementById("site-header");

  // Sombra del header al hacer scroll
  const onScroll = () => {
    const scrolled = window.scrollY > 10;
    header?.classList.toggle("shadow-2xl", scrolled);
    header?.classList.toggle("shadow-lg", !scrolled);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
