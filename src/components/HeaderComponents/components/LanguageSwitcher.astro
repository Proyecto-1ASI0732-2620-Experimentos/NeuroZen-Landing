---
import { Image } from "astro:assets";
import SpainFlag from "@/assets/images/Flags/spain_flag.png";
import UkFlag from "@/assets/images/Flags/uk_flag.png";
import {
  getAlternatePath,
  getLangFromUrl,
  useTranslations,
} from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const targetLang = lang === "es" ? "en" : "es";
const href = getAlternatePath(Astro.url, targetLang);
// Bandera y etiqueta indican el idioma de destino del enlace.
const flag = targetLang === "es" ? SpainFlag : UkFlag;
---

<a
  href={href}
  hreflang={targetLang}
  lang={targetLang}
  data-lang-switch
  aria-label={t("lang.switch")}
  title={t("lang.switch")}
  class="group inline-flex items-center justify-center gap-1.5 h-11 min-w-11 shrink-0 rounded-full border border-white/40 bg-white/10 px-1 min-[400px]:pl-1 min-[400px]:pr-2.5 text-white transition-colors duration-200 hover:bg-white/20"
>
  <Image
    src={flag}
    alt=""
    width={32}
    height={32}
    class="size-8 rounded-full object-cover"
  />
  <span class="hidden min-[400px]:inline text-xs font-bold tracking-wide" aria-hidden="true">
    {t("lang.label")}
  </span>
</a>

<script>
  // Conserva los parámetros de la URL y el ancla al cambiar de idioma.
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((link) => {
    link.addEventListener("click", () => {
      const { search, hash } = window.location;
      if (search || hash) {
        const url = new URL(link.href, window.location.origin);
        url.search = search;
        url.hash = hash;
        link.href = url.toString();
      }
    });
  });
</script>
