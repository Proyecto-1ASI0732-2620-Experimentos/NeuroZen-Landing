---
import type { HTMLAttributes } from "astro/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

type Variant = "primary" | "outline" | "light" | "ghost-light";

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href: string;
  text?: string;
  styles?: string;
  variant?: Variant;
  /** Abre el enlace en una pestaña nueva (añade rel y aviso accesible). */
  newTab?: boolean;
}

const {
  href,
  text,
  styles = "",
  variant = "primary",
  newTab = false,
  ...rest
} = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<a
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  class:list={["btn", `btn-${variant}`, styles]}
  {...rest}
>
  <slot name="icon" />
  {text}
  <slot />
  {newTab && <span class="sr-only">{t("a11y.newTab")}</span>}
</a>
