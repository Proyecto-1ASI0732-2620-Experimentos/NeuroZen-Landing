---
import Link from "../ui/Link.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  name: string;
  subtitle: string;
  price: string;
  features: string[];
  /** Destino real del botón en la Web App. */
  href: string;
  ctaText: string;
  isAdvanced?: boolean;
  /** Muestra el sufijo "/mes" junto al precio. */
  monthly?: boolean;
}

const { features, name, price, subtitle, href, ctaText, isAdvanced, monthly } =
  Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<article
  class:list={[
    "relative bg-white rounded-2xl p-6 sm:p-8 flex flex-col w-full md:flex-1 text-left",
    isAdvanced ? "border-2 border-brand shadow-xl" : "border border-gray-200 shadow-sm",
  ]}
>
  {
    isAdvanced && (
      <span class="absolute -top-3 left-6 rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">
        {t("plans.recommended")}
      </span>
    )
  }
  <h3>{name}</h3>
  <p class="text-gray-600 mb-4">{subtitle}</p>
  <p class="text-3xl font-bold text-gray-800 mb-6">
    {price}
    {monthly && <span class="text-base font-medium text-gray-600"> / {t("plans.monthly")}</span>}
  </p>

  <p class="sr-only">{t("plans.features")}</p>
  <ul class="space-y-2 mb-8 text-gray-700">
    {
      features.map((feature) => (
        <li class="flex gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 shrink-0 mt-0.5 text-brand"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
  <Link
    href={href}
    text={ctaText}
    variant={isAdvanced ? "primary" : "outline"}
    styles="mt-auto w-full"
  />
</article>
