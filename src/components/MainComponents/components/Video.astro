---
interface Props {
  title: string;
  description: string;
  srcLink: string;
}

const { title, description, srcLink } = Astro.props;
---

<div class="flex flex-col gap-4 w-full min-w-0 h-full">
  <div class="flex flex-col gap-2 flex-1">
    <h3>{title}</h3>
    <p class="text-gray-600 mb-4">{description}</p>
  </div>
  <iframe
    class="rounded-lg w-full aspect-video bg-gray-100 shadow-md"
    src={srcLink}
    title={title}
    loading="lazy"
    allow="autoplay; fullscreen"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
