---
import Section from "../components/Section.astro";

import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Video from "../components/Video.astro";

const aboutTheTeamVideo =
  "https://drive.google.com/file/d/16jMDioUhBDkHK5oRhv3hPGo_qzby2eX6/preview";

const aboutTheProductAndroidVideo =
  "https://drive.google.com/file/d/1-_v0KUTrHYfdEqTVUWcZBBUHyfarLtC4/preview";

const aboutTheProductFlutterVideo =
  "https://drive.google.com/file/d/1dIQqiKSxE18Rq9H31cRZ0p-JRneJzTTm/view?usp=sharing";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section
  id="nosotros"
  title={t("about.title")}
  description={t("about.description")}
>
  <div class="flex flex-col lg:flex-row gap-10 items-center">
    <Video
      title={t("about.team.title")}
      description={t("about.team.description")}
      srcLink={aboutTheTeamVideo}
    />
    <Video
      title={t("about.product.android.title")}
      description={t("about.product.description")}
      srcLink={aboutTheProductAndroidVideo}
    />
    <Video
      title={t("about.product.flutter.title")}
      description={t("about.product.description")}
      srcLink={aboutTheProductFlutterVideo}
    />
  </div>
</Section>
