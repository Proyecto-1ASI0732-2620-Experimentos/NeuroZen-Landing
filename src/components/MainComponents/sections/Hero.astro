---
import Section from "../components/Section.astro";
import Link from "../ui/Link.astro";
import { getLangFromUrl, getLocalizedPath, useTranslations } from "@/i18n/utils";
import { webAppLinks } from "@/consts/links";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="hero">
  <div class="flex flex-col gap-4 text-white max-w-4xl">
    <h1
      class="text-4xl min-[400px]:text-5xl md:text-6xl uppercase font-bold drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]"
    >
      {t("hero.title")}
    </h1>
    <p
      class="text-lg md:text-xl font-medium drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
    >
      {t("hero.subtitle")}
    </p>
  </div>
  <div
    class="flex flex-col gap-4 items-center bg-white/95 backdrop-blur-sm p-5 sm:p-6 rounded-2xl shadow-2xl w-full max-w-2xl"
  >
    <p class="text-gray-800 text-lg font-semibold">
      {t("hero.cta.text")}
    </p>
    <div
      class="flex flex-col sm:flex-row items-stretch justify-center gap-3 w-full"
    >
      <!-- Acción principal: registro en la Web App -->
      <Link
        href={webAppLinks.register}
        text={t("hero.cta.primary")}
        variant="primary"
        styles="text-lg px-8 py-4 sm:min-w-60 border-2 border-brand"
      />
      <!-- Acción secundaria: página informativa de descarga del APK -->
      <Link
        href={getLocalizedPath(lang, "descargar")}
        variant="outline"
        styles="text-lg px-6 py-4 sm:min-w-60"
      >
        <svg
          slot="icon"
          xmlns="http://www.w3.org/2000/svg"
          class="size-6 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14"></path>
        </svg>
        {t("hero.cta.secondary")}
      </Link>
    </div>
    <p class="text-sm text-gray-600 max-w-xl">{t("hero.cta.note")}</p>
    <p class="text-sm text-gray-700">
      {t("hero.cta.login")}
      <a
        href={webAppLinks.login}
        class="inline-block py-1 font-semibold text-brand underline underline-offset-4 hover:text-brand-active"
      >
        {t("nav.login")}
      </a>
    </p>
  </div>
</Section>
