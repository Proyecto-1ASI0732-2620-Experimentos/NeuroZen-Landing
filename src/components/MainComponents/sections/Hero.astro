---
import Section from "../components/Section.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { pendingActionUrl } from "@/consts/links";
import gPlayButtonImage from "@/assets/images/gplaybutton.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="hero">
  <div class="flex flex-col gap-4 text-white max-w-4xl">
    <h1
      class="text-5xl md:text-6xl uppercase font-bold drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]"
    >
      {t("hero.title")}
    </h1>
    <p
      class="text-lg md:text-xl font-medium drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
    >
      {t("hero.subtitle")}
    </p>
  </div>
  <div
    class="flex flex-col gap-4 items-center bg-black/40 backdrop-blur-sm p-6 rounded-xl border border-white/20"
  >
    <p class="text-white text-lg font-medium">
      {t("hero.cta.text")}
    </p>
    <div class="flex flex-col md:flex-row items-center justify-center gap-3 w-full">
      <a href="/playstore">
        <img
          src={gPlayButtonImage.src}
          alt="Google Play"
          class="px-6 py-3 cursor-pointer object-fill w-80"
        />
      </a>
      <a
        href={pendingActionUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center px-8 py-4 w-80 min-h-16 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-bold rounded-lg shadow-lg transition-all duration-300 hover:scale-105"
      >
        NeuroZen App
      </a>
    </div>
  </div>
</Section>
