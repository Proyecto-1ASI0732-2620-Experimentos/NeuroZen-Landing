---
import Section from "../components/Section.astro";
import Psychologist from "../components/Psychologist.astro";
import { psychologists } from "@/consts/psychologists";
import Link from "../ui/Link.astro";
import { webAppLinks } from "@/consts/links";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Directorio real de psicólogos en la Web App (requiere sesión).
const therapistsUrl = webAppLinks.therapists;
---

<Section
  id="psicologos"
  title={t("psychologists.section.title")}
  description={t("psychologists.section.description")}
  hasGreenBg
  styles="pb-16"
>
  <div class="flex flex-col gap-8 w-full px-4">
    {
      psychologists.map((psychologist, index) => (
        <Psychologist psychologist={psychologist} index={index} />
      ))
    }
  </div>

  <!-- CTA adicional -->
  <div
    class="mt-8 text-center bg-white rounded-2xl p-6 md:p-8 shadow-lg max-w-2xl mx-auto"
  >
    <h3 class="text-xl md:text-2xl font-bold text-gray-800 mb-3">
      {t("psychologists.cta.question")}
    </h3>
    <p class="text-sm md:text-base text-gray-600 mb-6">
      {t("psychologists.cta.help")}
    </p>
    <Link
      href={therapistsUrl}
      text={t("psychologists.cta.find")}
      styles="px-6 md:px-8"
    />
    <p class="mt-4 text-sm text-gray-600">{t("psychologists.loginNote")}</p>
  </div>
</Section>
