# Cabeceras de Netlify (se publica junto al sitio; no cambia la configuración del despliegue).
# El APK se descarga como archivo con el nombre correcto.
/downloads/NeuroZen.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="NeuroZen.apk"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
